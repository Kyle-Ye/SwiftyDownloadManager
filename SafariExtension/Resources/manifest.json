{
  "manifest_version": 2,
  "name": "Swifty Download Manager",
  "description": "Send downloadable links from Safari to Swifty Download Manager.",
  "version": "0.2.0",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Open Swifty Download Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "<all_urls>",
    "contextMenus",
    "nativeMessaging"
  ]
}
